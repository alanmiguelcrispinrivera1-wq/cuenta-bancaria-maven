<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Las coordenadas: quién soy en el mundo Maven -->
    <groupId>com.academia</groupId>
    <artifactId>cuenta-bancaria-maven</artifactId>
    <version>1.0.0</version>

    <properties>
        <!-- Compila para Java 17 -->
        <maven.compiler.release>17</maven.compiler.release>
        <!-- Los archivos están en UTF-8 (acentos) -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Las versiones, en un solo lugar -->
        <jackson.version>2.22.3</jackson.version>
        <junit.version>5.14.4</junit.version>
    </properties>

    <dependencies>
        <!-- JUnit 5, solo para las pruebas (scope test) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Jackson: convierte objetos de Java a JSON (y de regreso) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <!-- Quien arma el .jar; aquí le decimos cuál es la clase con main -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.academia.banco.App</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- Arma un segundo .jar «gordo»: tu código + el de todas tus dependencias -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Sin esto, deja un «dependency-reduced-pom.xml» junto a tu pom -->
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>